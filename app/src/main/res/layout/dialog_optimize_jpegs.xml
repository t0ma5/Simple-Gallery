<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/big_margin"
    android:paddingTop="@dimen/normal_margin"
    android:paddingBottom="@dimen/normal_margin">

    <com.simplemobiletools.commons.views.MyTextView
        android:id="@+id/optimize_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/optimize_jpegs_confirmation"
        android:textSize="@dimen/bigger_text_size" />

    <com.simplemobiletools.commons.views.MyAppCompatCheckbox
        android:id="@+id/optimize_lossless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin"
        android:text="@string/optimize_jpegs_lossless" />

    <com.simplemobiletools.commons.views.MyTextView
        android:id="@+id/optimize_quality_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:textSize="@dimen/bigger_text_size" />

    <com.simplemobiletools.commons.views.MySeekBar
        android:id="@+id/optimize_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:max="100"
        android:min="50"
        android:progress="85" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/optimize_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary" />
</LinearLayout>
