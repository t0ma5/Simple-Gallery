<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <tomato.simple.gallery.panorama.PanoramaGLSurfaceView
        android:id="@+id/panorama_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/panorama_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/gradient_background_flipped"
        app:navigationIcon="@drawable/ic_arrow_left_vector"
        app:titleTextColor="@android:color/white" />

    <ImageView
        android:id="@+id/panorama_gyro"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:alpha="0.45"
        android:background="@drawable/circle_black_background"
        android:contentDescription="@string/toggle_gyro"
        android:padding="10dp"
        android:src="@drawable/ic_orientation_auto_vector" />

</RelativeLayout>
